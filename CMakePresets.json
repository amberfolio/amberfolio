{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },

    {
      "name": "windows-msvc",
      "displayName": "Windows (MSVC, x64)",
      "description": "Run from a Visual Studio developer shell so cl and ninja are on PATH.",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },

    {
      "name": "macos",
      "displayName": "macOS (universal: arm64 + x86_64)",
      "description": "One preset covers both architectures via CMAKE_OSX_ARCHITECTURES.",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },

    {
      "name": "linux-gcc",
      "displayName": "Linux (GCC, x86-64)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },

    {
      "name": "linux-clang",
      "displayName": "Linux (Clang, x86-64)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },

    {
      "name": "linux-asan-ubsan",
      "displayName": "Linux (Clang, ASan + UBSan)",
      "description": "The test suite under AddressSanitizer and UndefinedBehaviorSanitizer. Builds no host: the sanitizers cover the core and its tests, and instrumenting all of SDL3 would put a third-party project's findings in front of ours.",
      "inherits": "linux-clang",
      "cacheVariables": {
        "AMBERFOLIO_SANITIZE": "address,undefined",
        "AMBERFOLIO_BUILD_HOST_SDL": "OFF"
      }
    },

    {
      "name": "wasm",
      "displayName": "WebAssembly (Emscripten, wasm32)",
      "description": "Needs an activated emsdk (source emsdk_env), whose version README.md pins.",
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{EMSDK}",
        "rhs": ""
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "windows-msvc",
      "description": "Debug is the bare preset's configuration on every platform.",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },

    { "name": "macos", "configurePreset": "macos", "configuration": "Debug" },
    {
      "name": "macos-debug",
      "configurePreset": "macos",
      "configuration": "Debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos",
      "configuration": "Release"
    },

    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },

    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang",
      "configuration": "Release"
    },

    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan",
      "configuration": "Debug"
    },
    {
      "name": "linux-asan-ubsan-debug",
      "configurePreset": "linux-asan-ubsan",
      "configuration": "Debug"
    },
    {
      "name": "linux-asan-ubsan-release",
      "description": "Sanitizers with optimisation on. Reaches code a Debug build's assertions cut short; the module forces -g, so reports still carry line numbers.",
      "configurePreset": "linux-asan-ubsan",
      "configuration": "Release"
    },

    { "name": "wasm", "configurePreset": "wasm", "configuration": "Debug" },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm",
      "configuration": "Debug"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm",
      "configuration": "Release"
    }
  ],

  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "description": "A test that hangs must fail, and soon: CTest's default is 1500 seconds, which on Windows is what a crashed test's modal abort dialog costs a CI job. Nothing here takes a second; raise this the day something legitimately needs to.",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false,
        "timeout": 120
      }
    },

    {
      "name": "sanitizer-env",
      "hidden": true,
      "description": "Runtime options for the sanitizer presets. Deliberately no log_path: the default is stderr, which is what outputOnFailure puts in front of whoever is reading the failure.",
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_leaks=1:detect_stack_use_after_return=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },

    {
      "name": "windows-msvc",
      "inherits": "test-base",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "test-base",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "inherits": "test-base",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },

    {
      "name": "macos",
      "inherits": "test-base",
      "configurePreset": "macos",
      "configuration": "Debug"
    },
    {
      "name": "macos-debug",
      "inherits": "test-base",
      "configurePreset": "macos",
      "configuration": "Debug"
    },
    {
      "name": "macos-release",
      "inherits": "test-base",
      "configurePreset": "macos",
      "configuration": "Release"
    },

    {
      "name": "linux-gcc",
      "inherits": "test-base",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "test-base",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-release",
      "inherits": "test-base",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },

    {
      "name": "linux-clang",
      "inherits": "test-base",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-debug",
      "inherits": "test-base",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-release",
      "inherits": "test-base",
      "configurePreset": "linux-clang",
      "configuration": "Release"
    },

    {
      "name": "linux-asan-ubsan",
      "inherits": ["test-base", "sanitizer-env"],
      "configurePreset": "linux-asan-ubsan",
      "configuration": "Debug"
    },
    {
      "name": "linux-asan-ubsan-debug",
      "inherits": ["test-base", "sanitizer-env"],
      "configurePreset": "linux-asan-ubsan",
      "configuration": "Debug"
    },
    {
      "name": "linux-asan-ubsan-release",
      "inherits": ["test-base", "sanitizer-env"],
      "configurePreset": "linux-asan-ubsan",
      "configuration": "Release"
    },

    {
      "name": "wasm",
      "inherits": "test-base",
      "configurePreset": "wasm",
      "configuration": "Debug"
    },
    {
      "name": "wasm-debug",
      "inherits": "test-base",
      "configurePreset": "wasm",
      "configuration": "Debug"
    },
    {
      "name": "wasm-release",
      "inherits": "test-base",
      "configurePreset": "wasm",
      "configuration": "Release"
    }
  ]
}
