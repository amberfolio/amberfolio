# SPDX-License-Identifier: AGPL-3.0-only

# Build trees. The presets put every configuration under build/<preset>/;
# the other names catch hand-rolled and IDE-driven builds.
/build/
/out/
/cmake-build-*/

# Per-developer preset overrides (compilers, paths, local SDL3 checkouts).
CMakeUserPresets.json

# Deployment staging. CI assembles the wasm host here before pushing it
# (deploy/vercel/README.md); `vercel link` drops project IDs in it and a
# short-lived OIDC token in .env.local beside it. None of that is ours to
# commit — the deployment's only input is the build tree.
.vercel/
.env*

# Generated compilation database and tool caches.
compile_commands.json
/.cache/
__pycache__/
*.py[cod]

# Editors and OS droppings.
.vs/
.vscode/
.idea/
.DS_Store

# Agent worktrees. The Claude Code harness makes a git worktree per
# background agent under here; each is a checkout of this repository, so
# `git add -A` at the root would otherwise stage a dozen embedded
# repositories. Ignored rather than the whole of .claude/, because
# anything a human puts there deliberately should still be trackable.
/.claude/worktrees/

# The maintainer's own game copy, for local boot and sweep runs only
# (PLAN.md §2: the player supplies it; §6: CI never sees it). Ignored so
# that no `git add` can ever stage it — the content guard would refuse the
# commit, but the right number of chances to take is zero.
/games/
