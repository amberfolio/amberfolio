<!doctype html>
<!-- SPDX-License-Identifier: AGPL-3.0-only

     M2-H2 (#55) dev page: proves frame, audio and input all cross the
     wasm boundary. Deliberately bare — this is scaffolding, not the M6
     reference shell (no onboarding, no persistence, no touch, no
     styling worth the name). Click Start; it draws a pattern, plays a
     tone, and echoes whatever you type into the console below.

     ES modules need a real origin, so open it over HTTP, not file://:
         cmake --build --preset wasm
         python3 scripts/serve-web.py

     A template, not a plain page: CMake substitutes
     AMBERFOLIO_SOURCE_URL into the source offer at the bottom (see
     hosts/web/CMakeLists.txt) — spelled without its at-signs here, or
     this comment would be substituted too. Nothing else is: the rule is
     @ONLY, so the ${...} in app.mjs/host.mjs is JS, not CMake.
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Amber Folio — M2 dev page</title>
    <style>
      body {
        margin: 0;
        padding: 2rem;
        background: #14100c;
        color: #e8d9bd;
        font: 1rem/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      h1 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 0.25rem;
      }
      p.note {
        color: #b3a58c;
        margin: 0 0 1.5rem;
        max-width: 60ch;
      }
      #screen {
        display: block;
        image-rendering: pixelated;
        image-rendering: crisp-edges;
        width: 640px;
        height: 400px;
        background: #000;
        border: 1px solid #3a2f22;
      }
      #controls {
        margin: 1rem 0;
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      button {
        font: inherit;
        background: #2a2115;
        color: #e8d9bd;
        border: 1px solid #5a4a30;
        padding: 0.5rem 1rem;
        cursor: pointer;
      }
      button:disabled {
        cursor: default;
        opacity: 0.6;
      }
      #status {
        color: #b3a58c;
      }
      #console {
        margin: 1rem 0 0;
        padding: 0.75rem;
        max-width: 640px;
        max-height: 12rem;
        overflow-y: auto;
        white-space: pre-wrap;
        background: #0a0805;
        border: 1px solid #3a2f22;
      }
      footer {
        margin: 2rem 0 0;
        padding: 1rem 0 0;
        border-top: 1px solid #3a2f22;
        font-size: 0.875rem;
        color: #b3a58c;
        max-width: 640px;
      }
      footer a {
        color: #e0a33c;
      }
    </style>
  </head>
  <body>
    <h1>Amber Folio — M2 dev page</h1>
    <p class="note">
      This is scaffolding, not a game: it proves the wasm build can run a
      machine end to end — video, sound and the keyboard — nothing more.
      Autoplay policy means the browser will not let a page start audio
      before you interact with it, so nothing runs until you click Start.
    </p>

    <div id="controls">
      <button id="start" type="button">start</button>
      <span id="status">idle - click start</span>
    </div>

    <canvas id="screen" width="320" height="200"></canvas>

    <pre id="console"></pre>

    <script type="module">
      // Imported dynamically, inside the try, rather than with a static
      // import at the top: a static one that fails takes the whole module
      // script with it, so the catch below never runs and the page sits
      // with the Start button doing nothing while saying why nowhere. That
      // is exactly the case worth reporting — a server that sends app.mjs
      // as text/plain, which browsers refuse to execute as a module, is
      // the usual way this page fails on a fresh machine.
      const status = document.getElementById('status');
      try {
        const { runDevPage } = await import('./app.mjs');
        runDevPage();
      } catch (error) {
        status.textContent = `failed to load: ${error}`;
        document.getElementById('start').disabled = true;
        console.error(error);
        throw error;
      }
    </script>

    <!-- Not decoration. AGPL-3.0-only §13: serving this program over a
         network obliges us to offer its users the Corresponding Source,
         and "the project is on GitHub somewhere" does not discharge
         that — the offer has to be reachable from the page, and it has
         to name the version being served. CI pins the URL to the commit
         it deployed; a local build points at the repository. -->
    <footer>
      Amber Folio is free software under AGPL-3.0-only.
      <a href="@AMBERFOLIO_SOURCE_URL@">Source code for this build</a>.
    </footer>
  </body>
</html>
