<!doctype html>
<!-- SPDX-License-Identifier: AGPL-3.0-only

     M0 placeholder page: it loads the wasm module and shows the core
     version. No canvas, no audio, no persistence — those land with the
     bare dev page in M2, and the reference shell (onboarding, toggle
     panel) in M6.

     ES modules need a real origin, so open it over HTTP, not file://:
         cmake --build --preset wasm
         python3 scripts/serve-web.py

     A template, not a plain page: CMake substitutes
     AMBERFOLIO_SOURCE_URL into the source offer at the bottom (see
     hosts/web/CMakeLists.txt) — spelled without its at-signs here, or
     this comment would be substituted too. Nothing else is: the rule is
     @ONLY, so the ${...} in the script below is JS, not CMake.
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Amber Folio — wasm module check</title>
    <style>
      body {
        margin: 0;
        padding: 2rem;
        background: #14100c;
        color: #e8d9bd;
        font: 1rem/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      h1 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 1rem;
      }
      pre {
        margin: 0;
        white-space: pre-wrap;
      }
      .failed {
        color: #ff8a7a;
      }
      footer {
        margin: 2rem 0 0;
        padding: 1rem 0 0;
        border-top: 1px solid #3a2f22;
        font-size: 0.875rem;
        color: #b3a58c;
      }
      footer a {
        color: #e0a33c;
      }
    </style>
  </head>
  <body>
    <h1>Amber Folio — wasm module check</h1>
    <pre id="out">loading…</pre>

    <script type="module">
      const out = document.getElementById('out');

      // Imported dynamically, inside the try, rather than with a static
      // import at the top: a static one that fails takes the whole module
      // script with it, so the catch below never runs and the page sits on
      // "loading…" saying nothing. That is exactly the case worth
      // reporting — a server that sends host.mjs as text/plain, which
      // browsers refuse to execute as a module, is the usual way this
      // page fails on a fresh machine.
      try {
        const { loadAmberfolio, formatVersion } = await import('./host.mjs');
        const { version, output } = await loadAmberfolio();
        out.textContent = [
          ...output,
          `af_version() reports ${formatVersion(version)}.`,
        ].join('\n');
      } catch (error) {
        out.classList.add('failed');
        out.textContent = [
          `failed to load the wasm module: ${error}`,
          '',
          'The browser console has the underlying error. If it mentions a',
          'MIME type, the server is the problem, not the build — serve the',
          'directory with scripts/serve-web.py, which sets them correctly.',
        ].join('\n');
        throw error;
      }
    </script>

    <!-- Not decoration. AGPL-3.0-only §13: serving this program over a
         network obliges us to offer its users the Corresponding Source,
         and "the project is on GitHub somewhere" does not discharge
         that — the offer has to be reachable from the page, and it has
         to name the version being served. CI pins the URL to the commit
         it deployed; a local build points at the repository. -->
    <footer>
      Amber Folio is free software under AGPL-3.0-only.
      <a href="@AMBERFOLIO_SOURCE_URL@">Source code for this build</a>.
    </footer>
  </body>
</html>
